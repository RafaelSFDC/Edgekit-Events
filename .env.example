# Credenciais da Aplicação Principal
DEFAULT_APP_ID=meu-app-id
DEFAULT_APP_KEY=minha-chave-publica
DEFAULT_APP_SECRET=meu-segredo-privado-ultra-seguro

# (Opcional) Multi-App: caso queira gerenciar múltiplos clientes ou projetos no mesmo Worker
# APPS_CONFIG=[{"id":"loja1","key":"key1","secret":"sec1"},{"id":"loja2","key":"key2","secret":"sec2"}]
