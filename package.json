{
  "name": "edgekit-events",
  "version": "1.0.0",
  "type": "module",
  "description": "Serverless, open-source Pusher clone running on Cloudflare Workers and Durable Objects — Edgekit Events",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "pnpm build:web && tsc --noEmit",
    "deploy": "pnpm build:web && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --project web/tsconfig.json --noEmit",
    "test": "npx tsx test/verify.ts"
  },
  "keywords": [
    "pusher",
    "realtime",
    "cloudflare",
    "workers",
    "durable-objects",
    "websockets",
    "hono",
    "serverless",
    "edgekit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "wrangler": "^3.114.0"
  }
}
